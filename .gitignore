# ── Secrets ─────────────────────────────────────────────────────────────────
# Never commit. .env.example carries the key names with placeholder values.
.env
.env.local

# ── Client data ─────────────────────────────────────────────────────────────
# Uploaded statements and generated client reports are real client records:
# they stay on the machine that produced them and never reach the repository.
uploads/
*_Holdings.xlsx
*.db
*.db-journal
*.sqlite3

# ── Fetched reference data ──────────────────────────────────────────────────
# Exchange masters, BhavCopy files and AMFI NAVs. Several MB, regenerated by
# the daily refresh, and stale the moment they are committed.
data/*.csv
data/*.txt
data/*.zip

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# ── Logs and scratch ────────────────────────────────────────────────────────
logs/
*.log

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.csv