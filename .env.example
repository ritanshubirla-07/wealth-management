OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# ── Screener.in market data ─────────────────────────────────────────────────
# Scraping uses PUBLIC company pages only and needs no login. These exist for
# the optional extras that are behind Screener's sign-in (insider-trade filings).
# NEVER commit real values: .env is gitignored, .env.example is not.
# Rotate the password if it has ever been pasted into a chat or a ticket.
# SCREENER_EMAIL=
# SCREENER_PASSWORD=

# Refresh prices + fundamentals automatically after each statement upload
SCREENER_AUTO_REFRESH=true
# Skip any security already priced within this many minutes (default 720 = 12h)
SCREENER_AUTO_REFRESH_MAX_AGE=720

# 10-year G-Sec yield used by checklist item 32 (earnings yield). Update as rates move.
GSEC_10Y_YIELD=6.5
